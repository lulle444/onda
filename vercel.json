{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/check-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/weekly",
      "schedule": "30 8 * * 1"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "assets/logo-mark.png"
    }
  },
  "redirects": [
    {
      "source": "/tripod",
      "destination": "https://usetripod.org/",
      "permanent": false
    },
    {
      "source": "/tripod/:path*",
      "destination": "https://usetripod.org/:path*",
      "permanent": false
    },
    {
      "source": "/legwork",
      "destination": "https://usetripod.org/",
      "permanent": false
    },
    {
      "source": "/legwork/:path*",
      "destination": "https://usetripod.org/:path*",
      "permanent": false
    },
    {
      "source": "/stocks",
      "destination": "/yields",
      "permanent": false
    },
    {
      "source": "/stock-yield",
      "destination": "/yields",
      "permanent": false
    },
    {
      "source": "/leaderboard",
      "destination": "/yields",
      "permanent": false
    },
    {
      "source": "/chain",
      "destination": "/yields",
      "permanent": false
    }
  ]
}
