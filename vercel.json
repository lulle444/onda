{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/check-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/weekly",
      "schedule": "30 8 * * 1"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "assets/logo-mark.png"
    },
    "api/pool-page.js": {
      "includeFiles": "pool.html"
    },
    "api/compare-page.js": {
      "includeFiles": "compare.html"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "onda-plum.vercel.app"
        }
      ],
      "destination": "https://usebasewatch.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/tripod",
      "destination": "https://usetripod.org/",
      "permanent": false
    },
    {
      "source": "/tripod/:path*",
      "destination": "https://usetripod.org/:path*",
      "permanent": false
    },
    {
      "source": "/legwork",
      "destination": "https://usetripod.org/",
      "permanent": false
    },
    {
      "source": "/legwork/:path*",
      "destination": "https://usetripod.org/:path*",
      "permanent": false
    },
    {
      "source": "/stocks",
      "destination": "/yields",
      "permanent": false
    },
    {
      "source": "/stock-yield",
      "destination": "/yields",
      "permanent": false
    },
    {
      "source": "/leaderboard",
      "destination": "/yields",
      "permanent": false
    },
    {
      "source": "/chain",
      "destination": "/yields",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pool/:slug",
      "destination": "/api/pool-page?slug=:slug"
    },
    {
      "source": "/compare/:ids",
      "destination": "/api/compare-page?ids=:ids"
    }
  ]
}
